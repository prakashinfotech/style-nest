{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=StyleNestDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;",
    "Redis": ""
  },
  "Redis": {
    "UseManagedIdentity": false,
    "ClientId": ""
  },
  "Jwt": {
    "Issuer": "stylenest-auth",
    "Audience": "stylenest-client",
    "PublicKey": "REPLACE_WITH_RSA_PUBLIC_KEY_PEM"
  },
  "BackInStockNotifier": {
    "IntervalMinutes": 60
  },
  "SearchWarmUp": {
    "Enabled": true,
    "DelaySeconds": 30,
    "Queries": []
  },
  "AzureCognitiveSearch": {
    "Endpoint": "REPLACE_WITH_AZURE_COGNITIVE_SEARCH_ENDPOINT",
    "ApiKey": "REPLACE_WITH_API_KEY",
    "IndexName": "stylenest-products",
    "SynonymMapName": "stylenest-synonyms"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
