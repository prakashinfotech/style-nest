{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=StyleNestDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "stylenest-auth",
    "Audience": "stylenest-client",
    "AccessTokenMinutes": "15",
    "PublicKey": "REPLACE_WITH_RSA_PUBLIC_KEY_PEM",
    "PrivateKey": "REPLACE_WITH_RSA_PRIVATE_KEY_PEM"
  },
  "Facebook": {
    "AppId":            "REPLACE_WITH_FACEBOOK_APP_ID",
    "AppSecret":        "REPLACE_WITH_FACEBOOK_APP_SECRET",
    "GraphApiVersion":  "v18.0"
  },
  "Apple": {
    "ClientId": "REPLACE_WITH_APPLE_SERVICE_ID"
  },
  "OtpDelivery": {
    "Provider": "AzureCommunication",
    "AzureCommunication": {
      "ConnectionString": "REPLACE_WITH_ACS_CONNECTION_STRING",
      "SenderAddress": "donotreply@stylenest.com"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
