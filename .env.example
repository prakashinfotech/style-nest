# ============================================================
# StyleNest E-Commerce Clone — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# ---- SQL Server ----
SQLSERVER_SA_PASSWORD=DevPsspl@123
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=StyleNestDb

# ---- Connection Strings (used in appsettings.Development.json) ----
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=StyleNestDb;User Id=sa;Password=DevPsspl@123;TrustServerCertificate=True

# ---- JWT (RS256) ----
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
Jwt__PrivateKeyPath=./keys/private.pem
Jwt__PublicKeyPath=./keys/public.pem
Jwt__Issuer=https://stylenest-auth.local
Jwt__Audience=stylenest-spa
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=7

# ---- Redis (V2 — not used until Phase 5) ----
# Redis__ConnectionString=localhost:6379

# ---- Azure (V2 — DO NOT configure until Phase 5) ----
# Azure__BlobStorage__ConnectionString=
# Azure__ServiceBus__ConnectionString=
# Azure__CognitiveSearch__Endpoint=
# Azure__CognitiveSearch__ApiKey=
# Azure__OpenAI__Endpoint=
# Azure__OpenAI__ApiKey=
# Azure__KeyVault__VaultUri=

# ---- Razorpay (V2 — DO NOT configure until Phase 5) ----
# Razorpay__KeyId=
# Razorpay__KeySecret=

# ---- Notification (V2) ----
# Msg91__AuthKey=
# Azure__CommunicationServices__ConnectionString=
# Fcm__ServerKey=

# ---- Angular ----
# User Storefront :4200 | Admin Panel :4201
# Set in user-storefront/src/environments/ and admin-panel/src/environments/
ANGULAR_API_BASE_URL=http://localhost:5000
ANGULAR_STOREFRONT_PORT=4200
ANGULAR_ADMIN_PANEL_PORT=4201

# ---- Service Ports ----
GATEWAY_PORT=5000
AUTH_API_PORT=5001
USER_API_PORT=5002
CATALOG_API_PORT=5003
CART_API_PORT=5004
ORDER_API_PORT=5005
ADMIN_API_PORT=5009
SELLER_API_PORT=5010
MEDIA_API_PORT=5011

# ---- MinIO (Media.API local storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=stylenest-media
